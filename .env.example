# Copia este archivo como .env y ajusta los valores. El archivo .env no se sube al repositorio.

# PostgreSQL: donde la etapa 8 guarda los resultados y de donde lee el agente.
# El usuario y la base de esta URL los crea scripts/crear_bd.py.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/semana_ingenieria

# Clave del superusuario de PostgreSQL: solo la usa scripts/crear_bd.py
# (el usuario es "postgres"; para otro, define también POSTGRES_USER)
POSTGRES_PASSWORD=

# Modelos locales de Ollama (opcional: si no se definen se usan los de agente/config.py)
# AGENTE_MODELO=qwen3:4b
# AGENTE_MODELO_EMBEDDINGS=bge-m3
# OLLAMA_HOST=http://localhost:11434
